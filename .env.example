# Environment Variables for AI Earth
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ─── LLM Providers ───────────────────────────────
# OpenRouter (primary)
OPENROUTER_API_KEY=your_openrouter_key_here

# OpenAI (fallback)
OPENAI_API_KEY=your_openai_key_here

# Anthropic (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_key_here

# ─── Search APIs ─────────────────────────────────
# Serper (Google Search)
SERPER_API_KEY=your_serper_key_here

# ─── Environment ─────────────────────────────────
# Environment: dev / staging / production
AI_EARTH_ENV=dev

# Log level: DEBUG / INFO / WARNING / ERROR
AI_EARTH_LOG_LEVEL=INFO

# ─── Budget Limits ───────────────────────────────
# Maximum cost per run (USD)
AI_EARTH_MAX_COST_PER_RUN=1.00

# Maximum cost per day (USD)
AI_EARTH_MAX_COST_PER_DAY=10.00

# ─── Database ────────────────────────────────────
# SQLite path for research memory
AI_EARTH_MEMORY_DB=research_memory.db

# ─── Telemetry ───────────────────────────────────
# Enable telemetry
AI_EARTH_TELEMETRY_ENABLED=true
