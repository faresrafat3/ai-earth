# 🔑 AI Earth — API Keys Configuration (Template)
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git.

# ─── OpenRouter Keys ──────────────────────────────────
# Get keys from: https://openrouter.ai/keys
OPENROUTER_KEY_1=sk-or-v1-your-key-here
OPENROUTER_KEY_2=sk-or-v1-your-key-here
OPENROUTER_KEY_3=sk-or-v1-your-key-here
# ... add more as needed

OPENROUTER_ACCOUNTS=account1,account2,account3

# ─── GitHub Models Key ─────────────────────────────────
GITHUB_MODELS_KEY=ghp_your-key-here
GITHUB_MODELS_ACCOUNT=your-username

# ─── Google AI Studio Keys ─────────────────────────────
# Get keys from: https://aistudio.google.com/apikey
GOOGLE_KEY_1=AIzaSy-your-key-here
GOOGLE_KEY_2=AIzaSy-your-key-here
# ... add more as needed

GOOGLE_ACCOUNTS=account1,account2

# ─── Serper (Web Search) ───────────────────────────────
# Get key from: https://serper.dev/
SERPER_KEY=your-serper-key-here
