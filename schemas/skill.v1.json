{
    "schema_version": "1.0",
    "component": "SKILL_ENGINE",
    "description": "Schema for skill specifications in the Skill Engine",
    "fields": [
        {
            "name": "name",
            "type": "string",
            "required": true,
            "description": "Unique skill identifier"
        },
        {
            "name": "version",
            "type": "string",
            "required": true,
            "description": "Semantic version"
        },
        {
            "name": "domain",
            "type": "string",
            "required": true,
            "description": "Domain category (e.g., research, coding, analysis)"
        },
        {
            "name": "description",
            "type": "string",
            "required": true,
            "description": "What this skill accomplishes"
        },
        {
            "name": "instructions",
            "type": "string",
            "required": true,
            "description": "Step-by-step instructions for using this skill"
        },
        {
            "name": "contract",
            "type": "object",
            "required": true,
            "description": "SkillContract with P(precondition), O(operation), A(artifact), V(validator), F(failure)",
            "subfields": {
                "P": "Precondition — what must be true",
                "O": "Operation — what the skill does",
                "A": "Artifact — what it produces",
                "V": "Validator — how to verify success",
                "F": "Failure — what can go wrong"
            }
        },
        {
            "name": "performance_score",
            "type": "number",
            "required": true,
            "description": "Historical performance score (0-100)"
        },
        {
            "name": "usage_count",
            "type": "integer",
            "required": true,
            "description": "Number of times this skill has been used"
        },
        {
            "name": "source_run",
            "type": "string",
            "required": false,
            "description": "The run from which this skill was extracted"
        },
        {
            "name": "generation",
            "type": "integer",
            "required": false,
            "description": "Generation number within source run"
        },
        {
            "name": "parent_skill",
            "type": "string",
            "required": false,
            "description": "Name of parent skill if evolved from another"
        }
    ]
}
