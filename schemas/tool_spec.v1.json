{
    "schema_version": "1.0",
    "component": "TOOL_HUB",
    "description": "Schema for tool specifications in the Tool Hub",
    "fields": [
        {
            "name": "name",
            "type": "string",
            "required": true,
            "description": "Unique tool identifier"
        },
        {
            "name": "description",
            "type": "string",
            "required": true,
            "description": "What this tool does (for agent prompt)"
        },
        {
            "name": "version",
            "type": "string",
            "required": true,
            "description": "Semantic version (e.g., 1.0.0)"
        },
        {
            "name": "input_schema",
            "type": "object",
            "required": true,
            "description": "JSON Schema for tool inputs"
        },
        {
            "name": "output_schema",
            "type": "object",
            "required": true,
            "description": "JSON Schema for tool outputs"
        },
        {
            "name": "preconditions",
            "type": "array",
            "items": "string",
            "required": false,
            "description": "Conditions that must be true before invocation"
        },
        {
            "name": "failure_modes",
            "type": "array",
            "items": "object",
            "required": true,
            "description": "Possible failure scenarios and handling"
        },
        {
            "name": "cost_per_call_usd",
            "type": "number",
            "required": true,
            "description": "Estimated cost per invocation in USD"
        },
        {
            "name": "requires_sandbox",
            "type": "boolean",
            "required": true,
            "description": "Whether this tool needs sandbox execution"
        }
    ]
}
