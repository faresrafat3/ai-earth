{
    "schema_version": "1.0",
    "component": "TELEMETRY",
    "description": "Schema for telemetry events",
    "fields": [
        {
            "name": "event_id",
            "type": "string",
            "required": true,
            "description": "Unique event identifier (UUID)"
        },
        {
            "name": "run_id",
            "type": "string",
            "required": true,
            "description": "Which run this event belongs to"
        },
        {
            "name": "generation",
            "type": "integer",
            "required": true,
            "description": "Which generation within the run"
        },
        {
            "name": "timestamp",
            "type": "string",
            "required": true,
            "description": "ISO 8601 timestamp"
        },
        {
            "name": "event_type",
            "type": "string",
            "required": true,
            "description": "Type of event (section_start, section_end, llm_call, signal, error)"
        },
        {
            "name": "section",
            "type": "string",
            "required": true,
            "description": "Which pipeline section emitted this event"
        },
        {
            "name": "data",
            "type": "object",
            "required": true,
            "description": "Event-specific data payload"
        },
        {
            "name": "duration_ms",
            "type": "number",
            "required": false,
            "description": "Duration in milliseconds (for timed events)"
        }
    ]
}
